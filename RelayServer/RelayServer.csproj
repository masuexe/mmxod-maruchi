<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RollForward>LatestMajor</RollForward>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseRidGraph>true</UseRidGraph>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="!$(DefineConstants.Contains('WINDOWS')) AND !$(DefineConstants.Contains('LINUX')) AND !$(DefineConstants.Contains('MAC'))">
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);TRACE;WINDOWS;RELAYSERVER</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);TRACE;LINUX;RELAYSERVER</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);TRACE;MAC;RELAYSERVER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="!$(DefineConstants.Contains('RELAYSERVER'))">
    <DefineConstants>$(DefineConstants);RELAYSERVER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$(DefineConstants.Contains('WINDOWS'))">
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="!$(DefineConstants.Contains('WINDOWS'))">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MMX\MMX.csproj" />
  </ItemGroup>

</Project>
